/* 全局样式 */


page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  color: #333;
  background-color: #f5f5f5;
}

/* 通用样式 */
.container {
  padding: 20rpx;
}

/* 按钮样式 */
.btn {
  display: inline-block;
  padding: 20rpx 40rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  text-align: center;
  cursor: pointer;
}

.btn-primary {
  background-color: #07c160;
  color: #fff;
}

.btn-default {
  background-color: #f0f0f0;
  color: #333;
}

/* 卡片样式 */
.card {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

/* 标题样式 */
h1 {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

h2 {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

h3 {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

/* 文本样式 */
.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

.text-danger {
  color: #ff4d4f;
}

.text-success {
  color: #07c160;
}

.text-warning {
  color: #faad14;
}

/* 布局样式 */
.flex {
  display: flex;
}

.flex-column {
  flex-direction: column;
}

.flex-center {
  align-items: center;
  justify-content: center;
}

.flex-between {
  align-items: center;
  justify-content: space-between;
}

/* 边距样式 */
.mt-10 {
  margin-top: 10rpx;
}

.mt-20 {
  margin-top: 20rpx;
}

.mb-10 {
  margin-bottom: 10rpx;
}

.mb-20 {
  margin-bottom: 20rpx;
}

/* 图标样式 */
.icon {
  width: 48rpx;
  height: 48rpx;
  display: inline-block;
}
