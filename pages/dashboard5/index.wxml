<view class="dashboard-container">
  <view class="dashboard-header">
    <view class="header-left">
      <text class="dashboard-title">个股异动监控</text>
      <text class="update-time">更新: {{lastUpdateTime}}</text>
    </view>
    <view class="header-actions">
      <view class="icon-btn {{showSettings ? 'active' : ''}}" bindtap="toggleSettings">
        <text>⚙</text>
      </view>
      <view class="icon-btn {{isRefreshing ? 'loading' : ''}}" bindtap="manualRefresh">
        <text>↻</text>
      </view>
    </view>
  </view>

  <view class="settings-panel {{showSettings ? 'show' : ''}}">
    <view class="settings-section">
      <view class="section-title">更新频率</view>
      <view class="frequency-options">
        <view class="frequency-btn {{refreshInterval === 5000 ? 'active' : ''}}" data-interval="5000" bindtap="setRefreshInterval">5秒</view>
        <view class="frequency-btn {{refreshInterval === 10000 ? 'active' : ''}}" data-interval="10000" bindtap="setRefreshInterval">10秒</view>
        <view class="frequency-btn {{refreshInterval === 30000 ? 'active' : ''}}" data-interval="30000" bindtap="setRefreshInterval">30秒</view>
        <view class="frequency-btn {{refreshInterval === 60000 ? 'active' : ''}}" data-interval="60000" bindtap="setRefreshInterval">1分钟</view>
      </view>
    </view>
  </view>

  <view class="tabs">
    <view class="tab-item {{activeTab === 'realtime' ? 'active' : ''}}" data-tab="realtime" bindtap="switchTab">
      <text>实时异动</text>
    </view>
    <view class="tab-item {{activeTab === 'abnormal' ? 'active' : ''}}" data-tab="abnormal" bindtap="switchTab">
      <text>异常波动</text>
    </view>
  </view>

  <view class="content-area">
    <view class="realtime-panel" wx:if="{{activeTab === 'realtime'}}">
      <view class="filter-section">
        <scroll-view scroll-x class="filter-scroll">
          <view class="filter-bar">
            <view class="filter-chip {{alertTypeFilter === 'all' ? 'active' : ''}}" data-type="all" bindtap="setAlertTypeFilter">
              <text>全部</text>
            </view>
            <view class="filter-chip" wx:for="{{['surge','plunge','big_buy','big_sell','limit_up','limit_down','volume','new_high','new_low']}}" wx:key="*this"
              data-type="{{item}}" bindtap="setAlertTypeFilter" class="filter-chip {{alertTypeFilter === item ? 'active' : ''}}">
              <text>{{item === 'surge' ? '🚀 拉升' : item === 'plunge' ? '📉 跳水' : item === 'big_buy' ? '💰 大买' : item === 'big_sell' ? '💸 大卖' : item === 'limit_up' ? '🔺 涨停' : item === 'limit_down' ? '🔻 跌停' : item === 'volume' ? '📊 量比' : item === 'new_high' ? '🏆 新高' : '💀 新低'}}</text>
            </view>
          </view>
        </scroll-view>

        <scroll-view scroll-x class="filter-scroll">
          <view class="filter-bar">
            <view class="filter-chip {{boardFilter === 'all' ? 'active' : ''}}" data-board="all" bindtap="setBoardFilter">
              <text>全部板块</text>
            </view>
            <view class="filter-chip {{boardFilter === 'sh' ? 'active' : ''}}" data-board="sh" bindtap="setBoardFilter">
              <text>沪主板</text>
            </view>
            <view class="filter-chip {{boardFilter === 'sz' ? 'active' : ''}}" data-board="sz" bindtap="setBoardFilter">
              <text>深主板</text>
            </view>
            <view class="filter-chip {{boardFilter === 'cyb' ? 'active' : ''}}" data-board="cyb" bindtap="setBoardFilter">
              <text>创业板</text>
            </view>
            <view class="filter-chip {{boardFilter === 'kcb' ? 'active' : ''}}" data-board="kcb" bindtap="setBoardFilter">
              <text>科创板</text>
            </view>
            <view class="filter-chip {{boardFilter === 'bj' ? 'active' : ''}}" data-board="bj" bindtap="setBoardFilter">
              <text>北交所</text>
            </view>
          </view>
        </scroll-view>
      </view>

      <view class="alert-count">
        <text>共 {{filteredAlerts.length}} 条异动</text>
      </view>

      <view class="alert-list">
        <view class="alert-item" wx:for="{{filteredAlerts}}" wx:key="id">
          <view class="alert-content">
            <view class="alert-header">
              <view class="stock-info">
                <text class="stock-name">{{item.stockName}}</text>
                <text class="stock-code">{{item.stockCode}}</text>
              </view>
              <view class="alert-type-badge" style="background: {{item.alertColor}}20; color: {{item.alertColor}}">
                <text>{{item.alertIcon}} {{item.alertName}}</text>
              </view>
            </view>
            <view class="alert-body">
              <view class="price-info">
                <text class="price">{{item.price}}</text>
                <text class="change {{item.changePercent >= 0 ? 'up' : 'down'}}">
                  {{item.changePercent >= 0 ? '+' : ''}}{{item.changePercent}}%
                </text>
              </view>
              <view class="volume-info">
                <text class="volume-label">成交:</text>
                <text class="volume-value">{{item.amount}}万</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="empty-state" wx:if="{{filteredAlerts.length === 0 && !isLoading}}">
        <view class="empty-icon">📊</view>
        <text class="empty-title">暂无异动</text>
        <text class="empty-desc">当前筛选条件下没有异动数据</text>
      </view>
    </view>

    <view class="abnormal-panel" wx:if="{{activeTab === 'abnormal'}}">
      <view class="search-box">
        <view class="search-input-container">
          <text class="search-icon">🔍</text>
          <input class="search-input" placeholder="输入股票名称或代码查询" value="{{searchKeyword}}" bindinput="onSearchInput" />
          <view class="search-clear" wx:if="{{searchKeyword}}" bindtap="clearSearch">
            <text>✕</text>
          </view>
        </view>
      </view>

      <view class="filter-section" wx:if="{{!showSearch}}">
        <scroll-view scroll-x class="filter-scroll">
          <view class="filter-bar">
            <view class="filter-chip {{abnormalTypeFilter === 'all' ? 'active' : ''}}" data-type="all" bindtap="setAbnormalTypeFilter">
              <text>全部类型</text>
            </view>
            <view class="filter-chip {{abnormalTypeFilter === 'normal' ? 'active' : ''}}" data-type="normal" bindtap="setAbnormalTypeFilter">
              <text>⚠️ 异常波动</text>
            </view>
            <view class="filter-chip {{abnormalTypeFilter === 'severe' ? 'active' : ''}}" data-type="severe" bindtap="setAbnormalTypeFilter">
              <text>🔴 严重异常</text>
            </view>
          </view>
        </scroll-view>

        <scroll-view scroll-x class="filter-scroll">
          <view class="filter-bar">
            <view class="filter-chip {{abnormalBoardFilter === 'all' ? 'active' : ''}}" data-board="all" bindtap="setAbnormalBoardFilter">
              <text>全部板块</text>
            </view>
            <view class="filter-chip {{abnormalBoardFilter === 'sh' ? 'active' : ''}}" data-board="sh" bindtap="setAbnormalBoardFilter">
              <text>沪主板</text>
            </view>
            <view class="filter-chip {{abnormalBoardFilter === 'sz' ? 'active' : ''}}" data-board="sz" bindtap="setAbnormalBoardFilter">
              <text>深主板</text>
            </view>
            <view class="filter-chip {{abnormalBoardFilter === 'cyb' ? 'active' : ''}}" data-board="cyb" bindtap="setAbnormalBoardFilter">
              <text>创业板</text>
            </view>
            <view class="filter-chip {{abnormalBoardFilter === 'kcb' ? 'active' : ''}}" data-board="kcb" bindtap="setAbnormalBoardFilter">
              <text>科创板</text>
            </view>
            <view class="filter-chip {{abnormalBoardFilter === 'bj' ? 'active' : ''}}" data-board="bj" bindtap="setAbnormalBoardFilter">
              <text>北交所</text>
            </view>
          </view>
        </scroll-view>

        <scroll-view scroll-x class="filter-scroll">
          <view class="filter-bar">
            <view class="filter-chip {{abnormalPeriodFilter === 'all' ? 'active' : ''}}" data-period="all" bindtap="setAbnormalPeriodFilter">
              <text>全部周期</text>
            </view>
            <view class="filter-chip {{abnormalPeriodFilter === '3d' ? 'active' : ''}}" data-period="3d" bindtap="setAbnormalPeriodFilter">
              <text>3日</text>
            </view>
            <view class="filter-chip {{abnormalPeriodFilter === '5d' ? 'active' : ''}}" data-period="5d" bindtap="setAbnormalPeriodFilter">
              <text>5日</text>
            </view>
            <view class="filter-chip {{abnormalPeriodFilter === '10d' ? 'active' : ''}}" data-period="10d" bindtap="setAbnormalPeriodFilter">
              <text>10日</text>
            </view>
            <view class="filter-chip {{abnormalPeriodFilter === '30d' ? 'active' : ''}}" data-period="30d" bindtap="setAbnormalPeriodFilter">
              <text>30日</text>
            </view>
            <view class="filter-chip {{abnormalPeriodFilter === '60d' ? 'active' : ''}}" data-period="60d" bindtap="setAbnormalPeriodFilter">
              <text>60日</text>
            </view>
          </view>
        </scroll-view>
      </view>

      <view class="search-results" wx:if="{{showSearch}}">
        <view class="search-result-header">
          <text>搜索结果: {{searchResults.length}}条</text>
        </view>
        <view class="abnormal-list">
          <view class="abnormal-item" wx:for="{{searchResults}}" wx:key="id">
            <view class="abnormal-header">
              <view class="stock-info">
                <text class="stock-name">{{item.stockName}}</text>
                <text class="stock-code">{{item.stockCode}}</text>
                <text class="board-tag">{{item.boardName}}</text>
              </view>
              <view class="abnormal-type {{item.abnormalType}}">
                <text>{{item.abnormalTypeName}}</text>
              </view>
            </view>
            <view class="abnormal-body">
              <view class="abnormal-metrics">
                <view class="metric-item">
                  <text class="metric-label">偏离值</text>
                  <text class="metric-value {{item.deviation >= 0 ? 'up' : 'down'}}">
                    {{item.deviation >= 0 ? '+' : ''}}{{item.deviation}}%
                  </text>
                </view>
                <view class="metric-item">
                  <text class="metric-label">周期</text>
                  <text class="metric-value">{{item.periodName}}</text>
                </view>
                <view class="metric-item">
                  <text class="metric-label">触发次数</text>
                  <text class="metric-value">{{item.triggerCount}}次</text>
                </view>
                <view class="metric-item">
                  <text class="metric-label">公告状态</text>
                  <text class="metric-value {{item.announcementStatus === '已公告' ? 'announced' : 'pending'}}">
                    {{item.announcementStatus}}
                  </text>
                </view>
              </view>
            </view>
          </view>
        </view>
        <view class="empty-state" wx:if="{{searchResults.length === 0}}">
          <view class="empty-icon">🔍</view>
          <text class="empty-title">未找到匹配股票</text>
          <text class="empty-desc">请尝试其他关键词</text>
        </view>
      </view>

      <view class="abnormal-list" wx:if="{{!showSearch}}">
        <view class="abnormal-item" wx:for="{{filteredAbnormal}}" wx:key="id">
          <view class="abnormal-header">
            <view class="stock-info">
              <text class="stock-name">{{item.stockName}}</text>
              <text class="stock-code">{{item.stockCode}}</text>
              <text class="board-tag">{{item.boardName}}</text>
            </view>
            <view class="abnormal-type {{item.abnormalType}}">
              <text>{{item.abnormalTypeName}}</text>
            </view>
          </view>
          <view class="abnormal-body">
            <view class="abnormal-metrics">
              <view class="metric-item">
                <text class="metric-label">偏离值</text>
                <text class="metric-value {{item.deviation >= 0 ? 'up' : 'down'}}">
                  {{item.deviation >= 0 ? '+' : ''}}{{item.deviation}}%
                </text>
              </view>
              <view class="metric-item">
                <text class="metric-label">周期</text>
                <text class="metric-value">{{item.periodName}}</text>
              </view>
              <view class="metric-item">
                <text class="metric-label">触发次数</text>
                <text class="metric-value">{{item.triggerCount}}次</text>
              </view>
              <view class="metric-item">
                <text class="metric-label">公告状态</text>
                <text class="metric-value {{item.announcementStatus === '已公告' ? 'announced' : 'pending'}}">
                  {{item.announcementStatus}}
                </text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="empty-state" wx:if="{{filteredAbnormal.length === 0 && !showSearch && !isLoading}}">
        <view class="empty-icon">✅</view>
        <text class="empty-title">暂无异常波动</text>
        <text class="empty-desc">当前筛选条件下没有异常波动股票</text>
      </view>
    </view>
  </view>

  <view class="empty-state error" wx:if="{{error}}">
    <view class="empty-icon">⚠️</view>
    <text class="empty-title">加载失败</text>
    <text class="empty-desc">{{error}}</text>
    <view class="retry-btn" bindtap="manualRefresh">重试</view>
  </view>
</view>